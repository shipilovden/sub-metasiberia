# MetaSiberia standard primitive: sloped wedge, Y-up source coordinates.
o Wedge
usemtl default
v -0.500000 -0.500000 -0.500000
v 0.500000 -0.500000 -0.500000
v -0.500000 0.500000 -0.500000
v -0.500000 -0.500000 0.500000
v 0.500000 -0.500000 0.500000
v -0.500000 0.500000 0.500000
f 1 3 2
f 4 5 6
f 1 2 5 4
f 1 4 6 3
f 2 3 6 5
