.logopen /t C:\Users\densh\AppData\Local\Metasiberia\CrashDumps\analysis.txt
.symfix
.reload /f
.echo ===== Automated exception analysis =====
!analyze -v
.echo ===== Exception record and fault context =====
.exr -1
.ecxr
r
.echo ===== Faulting instruction and address mapping =====
ln @rip
!address @rip
u @rip-20 L40
.echo ===== Faulting thread call stack =====
kv
.echo ===== All thread call stacks =====
~* kv
.echo ===== Loaded module paths and address ranges =====
lmf
.echo ===== Address-space summary =====
!address -summary
.echo ===== Private executable regions =====
!address -f:MEM_PRIVATE
.echo ===== Executable and writable-executable regions =====
!address -f:PAGE_EXECUTE,PAGE_EXECUTE_READ,PAGE_EXECUTE_READWRITE,PAGE_EXECUTE_WRITECOPY
.echo ===== Heap summary =====
!heap -s
.logclose
